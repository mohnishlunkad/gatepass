projection;
strict ( 1 );
use draft;
use side effects;

define behavior for ZC_VEHIN_HEAD alias Head
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action print;
  use action setOutward;
  use association _Item { create; with draft; }
}

define behavior for ZC_VEHIN_ITEM alias Item
{
  use update;
  use delete;

  use association _Head { with draft; }
}